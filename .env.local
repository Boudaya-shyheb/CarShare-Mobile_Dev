#Neon
DATABASE_URL="*"
DATABASE_URL_UNPOOLED="*"
NEON_BRANCH=production

# Google OAuth : ID du client Web créé dans Google Cloud
GOOGLE_SERVER_CLIENT_ID= *

# SMTP : paramètres fournis par votre service d'envoi d'e-mails
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=*
MAIL_PASSWORD=*
MAIL_FROM=*
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true